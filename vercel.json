{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/met-cloisters-guide",
      "destination": "/guide-v3.html",
      "permanent": false
    },
    {
      "source": "/met-cloisters-guide/:path*",
      "destination": "/guide-v3.html",
      "permanent": false
    },
    {
      "source": "/met-guide",
      "destination": "/guide-v3.html",
      "permanent": false
    },
    {
      "source": "/met-guide/:path*",
      "destination": "/guide-v3.html",
      "permanent": false
    },
    {
      "source": "/guide-loader.html",
      "destination": "/guide-v3.html",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/guide-v3.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, max-age=0" }
      ]
    },
    {
      "source": "/guide.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, max-age=0" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
